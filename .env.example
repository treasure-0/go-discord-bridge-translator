# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token).
# Also enable "Message Content Intent" on the same page.
DISCORD_TOKEN=

# Channel IDs (Discord: Settings -> Advanced -> Developer Mode, then right-click a channel -> Copy ID)
CHANNEL_RU=
CHANNEL_INT=

# Translators in order of preference: the first available one is used, the rest are fallbacks.
# Providers without a key are skipped, so set at least one key.
TRANSLATORS=groq,azure,deepl,gemini

# Groq (fast LLM: understands slang, abbreviations and swearing). Free, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Azure AI Translator, free tier F0 = 2M characters/month (renews monthly).
# Azure portal -> Create "Translator" resource -> Keys and Endpoint.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
# AZURE_MONTHLY_LIMIT=2000000

# DeepL API (Developer plan = 1M characters in total, not renewed): https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Google Gemini (free tier, good with slang but slow): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Alerts (quota running low, translator down, bot restarted): your Discord user ID for DMs
# and/or an admin channel ID. Leave empty to disable.
ALERT_USER_ID=
ALERT_CHANNEL_ID=
# Warn when this percentage of a quota is left.
# QUOTA_ALERT_PERCENT=15
# Daily .txt report (usage, errors, crashes) to the alert channel/DM.
# REPORT_TIME=09:00
# REPORT_TZ=Europe/Berlin

# Where the message map and the ops journal (usage, errors, crashes) are stored. The systemd unit overrides this.
# DATA_DIR=data
