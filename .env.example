# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token).
# Also enable "Message Content Intent" on the same page.
DISCORD_TOKEN=

# Channel IDs (Discord: Settings -> Advanced -> Developer Mode, then right-click a channel -> Copy ID)
CHANNEL_RU=
CHANNEL_INT=

# Set at least one translator. With both, Gemini is used first and DeepL is the fallback.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# DeepL API Free key (ends with :fx): https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Where the message map (for replies/edits/deletes) is stored. The systemd unit overrides this.
# DATA_DIR=data
